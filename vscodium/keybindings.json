        "when": "chatInputHasText && inChatInput && !chatHasToolConfirmation && !chatSessionRequestInProgress && chatAgentKind == 'ask'"
    },
    {
        "key": "delete",
        "command": "-workbench.action.chat.undoEdits",
        "when": "inChat && !textInputFocus"
    },
]
